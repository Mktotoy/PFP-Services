# ---------------------------------------------------------------------------
# Formulaire de devis : configuration d'envoi
#
# En local, MAIL_PROVIDER=console suffit : le mail s'affiche dans le terminal
# au lieu d'etre emis. Ce mode est refuse en production, volontairement.
#
# En production, poser ces variables dans les Secrets de DEPLOIEMENT Replit,
# pas dans le .env de l'espace de travail : ce sont deux stockages distincts.
# ---------------------------------------------------------------------------

# graph | resend | console
MAIL_PROVIDER=console

# Boite expeditrice. Doit appartenir au domaine : SPF publie -all, donc une
# adresse exterieure serait rejetee. L'adresse du visiteur va en replyTo.
CONTACT_SENDER=contact@pfp-services.fr

# Destinataire du recapitulatif. Par defaut, identique a CONTACT_SENDER.
CONTACT_RECIPIENT=contact@pfp-services.fr

# --- MAIL_PROVIDER=graph ---------------------------------------------------
# Inscription d'application DEDIEE au site, distincte de Thomas-Claude-Review.
# Permission Graph Mail.Send en autorisation d'APPLICATION, consentement admin
# accorde, et ApplicationAccessPolicy limitant l'app a CONTACT_SENDER.
# Mise en place et controle : AIVault/scripts/pfp-mailflow/setup_site_sender.ps1
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
# Expire au maximum au bout de 24 mois : poser un rappel agenda.
GRAPH_CLIENT_SECRET=

# --- MAIL_PROVIDER=resend --------------------------------------------------
# Suppose le domaine pfp-services.fr verifie dans Resend (enregistrements DNS
# a ajouter chez OVH).
RESEND_API_KEY=
